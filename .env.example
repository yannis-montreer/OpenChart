# Optional. The web setup wizard stores everything without any file editing; use
# this file only for headless installs. Values saved in the web UI take precedence.
# Copy to .env (git-ignored). Never commit .env, never paste tokens in chat or issues.

# OANDA: "practice" or "live". Practice and live use different tokens and hosts.
OPENCHART_OANDA_ENV=practice
# Personal access token from the OANDA account portal (Manage API Access).
OPENCHART_OANDA_TOKEN=
# Account ID, format like 101-004-1234567-001
OPENCHART_OANDA_ACCOUNT_ID=

# Where the database and tick files live.
OPENCHART_DATA_DIR=data
# Bind address. Keep 127.0.0.1 unless you use Tailscale (see README).
OPENCHART_HOST=127.0.0.1
OPENCHART_PORT=8000
OPENCHART_LOG_LEVEL=INFO
# One log line per HTTP request (uvicorn's access log): off unless set to 1.
# OPENCHART_ACCESS_LOG=1

# Raw tick storage (Parquet, one file per day). How long they are kept is chosen in
# Settings, Data (30 days by default).
OPENCHART_STORE_TICKS=true
# Default minute history (M1) per instrument, in years: downloaded that far back, older
# minutes deleted daily. Each instrument can choose 3 months, 1 or 2 years in Settings.
OPENCHART_BACKFILL_YEARS=2
# H1 history as far back as the broker has it (OANDA gold: 2006), for 1h, 4h, D and W.
OPENCHART_DEEP_HISTORY=true

# Only where the OS has no credential store (Docker, headless Linux): a Fernet key;
# tokens are then kept in data/secrets.enc, encrypted with it.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OPENCHART_SECRET_KEY=
