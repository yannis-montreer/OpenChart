# Copy this file to .env and fill in your own values. .env is git-ignored.
# Never commit .env, never paste tokens in chat or issues.

# OANDA: "practice" or "live". Practice and live use different tokens and hosts.
OPENCHART_OANDA_ENV=practice
# Personal access token from the OANDA account portal (Manage API Access).
OPENCHART_OANDA_TOKEN=
# Account ID, format like 101-004-1234567-001
OPENCHART_OANDA_ACCOUNT_ID=

# Where the database and tick files live.
OPENCHART_DATA_DIR=data
# Bind address. Keep 127.0.0.1 unless you use Tailscale (see README).
OPENCHART_HOST=127.0.0.1
OPENCHART_PORT=8000
OPENCHART_LOG_LEVEL=INFO

# Raw tick storage (Parquet, one file per day).
OPENCHART_STORE_TICKS=true
# Default history depth for the first backfill, in years.
OPENCHART_BACKFILL_YEARS=2
