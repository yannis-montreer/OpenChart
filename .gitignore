# Secrets and local config
.env
.env.*
!.env.example
*.key

# Market data, databases, ticks (never commit market data)
data/
*.db
*.db-wal
*.db-shm
*.parquet
# Saved command output, e.g. `openchart gaps EUR_USD > eurusd-gaps.txt`
*-gaps*.txt

# Personal strategies stay out of this repo
strategies/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Frontend (the build lands in src/openchart/web and is produced by `npm run build`)
node_modules/
frontend/dist/
src/openchart/web/

# Machine-specific tool config
.claude/launch.json
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Owner's UI reference screenshots: kept locally, never published (they show a
# third-party product's interface). Only the folder placeholder is tracked.
reference/*
!reference/.gitkeep

# TradingView chart exports (the owner's, for comparison tests; never committed)
OANDA_*.csv
*tradingview*.csv

# Local notes for Claude Code sessions: the owner's paths and setup (see CLAUDE.md)
LOCAL-NOTES.md
